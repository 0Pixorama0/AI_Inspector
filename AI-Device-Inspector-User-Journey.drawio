<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="Front-End User Journey" id="journey"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" background="#F4F5FA" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl_login" value="1 · Sign in" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_login" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_login" value="/login" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_login" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Entry point. Operator, supervisor or admin authenticates by email + password (optional 2FA) or enterprise SSO (SAML/OIDC). Client chip shows the tenant.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;On success the user lands on their role home (Dashboard). A station kiosk starts a device-bound session with fast operator switching." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_dashboard" value="2 · Dashboard &amp; live floor" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_dashboard" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="430" y="186" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_dashboard" value="/dashboard" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_dashboard" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Role home / hub. Live station tiles (idle / busy / offline), shift KPIs (units, cycle time, AI accuracy, defect &amp; approval rate), trend + defect-mix charts and a live activity feed.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Click a station or KPI to drill in; use the sidebar to reach any screen. Supervisors jump to review queues; admins to management." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="430" y="378" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_import" value="7 · Import wizard" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_import" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="820" y="186" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_import" value="/history/import" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_import" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Five-step CSV importer: download template, upload, map fields, validate, preview &amp; commit. Reached from Inspection History.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;On commit, rows are created and the user returns to History with the new inspections listed." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="378" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_station" value="3 · Inspection Station" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_station" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_station" value="/station" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_station" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;The operator&#x27;s workflow. Six guided states shown on the right: 1 Scan barcode → 2 Verify asset → 3 Position device → 4 Capture (6 cameras) → 5 AI analysis → 6 Review. Live camera feed centre.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;A completed capture is sent to the model; detections come back and the operator moves to AI Review. Offline captures queue and sync on reconnect." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_review" value="4 · AI Review &amp; annotation" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_review" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="430" y="646" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_review" value="/review" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_review" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Model output on the six images: bounding boxes, heat-map, zoom-to-defect. Right rail lists each detection with confidence &amp; severity. Cursor tool resizes an AI box or draws a missed one; accept / reject / reclassify / merge.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Every edit is audited and fed back to training. Approve Result → grade is set and the record is saved; Reject sends it back." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="430" y="838" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_history" value="5 · Inspection History" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_history" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="820" y="646" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_history" value="/history" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_history" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;The master list: virtualised 16-column grid over 100k+ records, global search, advanced filters with saved presets, bulk actions (approve / reject / assign / archive / re-run AI / export) and role-gated inline editing.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Click a row to open its full record; use Import to add rows; export the current view to CSV / XLSX / PDF / JSON." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="838" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_detail" value="6 · Inspection Detail" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="610" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_detail" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="1210" y="646" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_detail" value="/history/[id]" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="610" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_detail" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;One device&#x27;s record across tabs — Overview, Images (drag-to-reorder), AI Results (defect viewer + health/grade), Audit Trail, Edit. Health score, cosmetic &amp; functional grades and suggested disposition.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Generate the branded PDF certificate (with tamper-evident hash) or an expiring share link for a buyer; supervisors override the grade with a reason." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1210" y="838" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_analytics" value="8 · Analytics" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_analytics" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="40" y="1106" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_analytics" value="/analytics" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_analytics" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Management view: throughput, cycle time, first-pass yield &amp; rework by station and shift, grade distribution over time, defect Pareto by supplier and AI-vs-human agreement.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Filter by date range, export to CSV, or schedule an email digest. Findings drive taxonomy and grading-profile changes in Admin." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1298" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_clients" value="9 · Clients" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="1070" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_clients" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="430" y="1106" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_clients" value="/clients" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="1070" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_clients" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Admin: manage client tenants — their branding, grading profiles and data isolation. Each client sees only their own consignments.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Open a client to edit its grade profile or report branding; changes take effect without a release." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="430" y="1298" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_stations" value="10 · Stations" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1070" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_stations" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="820" y="1106" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_stations" value="/stations" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="1070" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_stations" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Admin: register inspection stations and their six cameras, with calibration profiles and health/online status.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Add or recalibrate a station; its live status then appears on the Dashboard floor view." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="1298" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_users" value="11 · Users" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="1070" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_users" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="1210" y="1106" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_users" value="/users" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="1070" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_users" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;Admin: manage user accounts and roles (Operator / Supervisor / Admin / Client) against the published permission matrix, enforced server-side.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Invite or deactivate users, change roles; permissions apply immediately across every screen and the API." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1210" y="1298" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="ttl_settings" value="12 · Settings" style="rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="1070" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="img_settings" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#D9DCEA;" vertex="1" parent="1"><mxGeometry x="1600" y="1106" width="300" height="188" as="geometry"/></mxCell>
<mxCell id="rt_settings" value="/settings" style="text;html=1;align=right;verticalAlign=middle;fontColor=#0E9AAC;fontSize=10;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1070" width="290" height="34" as="geometry"/></mxCell>
<mxCell id="dsc_settings" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;System: defect taxonomy &amp; severity rules, grading-profile builder (with historic preview), notification rules, retention/erasure policy and per-tenant feature flags.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7C3AED&quot;&gt;&amp;#8594; Next&lt;/b&gt;&lt;br&gt;Edits here reconfigure grading, capture and alerts across the platform — configuration, not a code release." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D9DCEA;fontColor=#1A1B2E;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=10;spacingTop=8;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1298" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="e1" value="Sign in → role home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_login" target="img_dashboard"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="Start / open a station" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_dashboard" target="img_station"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="Capture done → detections ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_station" target="img_review"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="Approve / Reject → record saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_review" target="img_history"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="Click a row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_history" target="img_detail"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="Commit CSV → rows added" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_import" target="img_history"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="View all inspections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_dashboard" target="img_history"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="Drill into metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_dashboard" target="img_analytics"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="Trends feed insight" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1A1B2E;fontSize=10;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img_detail" target="img_analytics"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6A6C83;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="img_dashboard" target="img_clients"><mxGeometry relative="1" as="geometry"/></mxCell>
